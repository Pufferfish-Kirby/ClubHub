# Claude API
ANTHROPIC_API_KEY=

# Voyage AI embeddings
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-lite
VOYAGE_EMBEDDING_DIMENSIONS=1024

# Dropbox app (App Console -> scoped access; use refresh-token/offline access flow)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_INBOX_PATH=/Inbox

# SOP source
SOP_BASE_URL=https://sop.utoronto.ca/wp-json
SOP_CAMPUS=St. George
SOP_USER_AGENT=CampusCompass/0.1 (hackathon project; contact: you@example.com)

# Storage
DATABASE_URL=sqlite:///./data/campus_compass.db
CHROMA_PERSIST_DIR=./data/chroma

# Security (app/security.py)
# ENVIRONMENT=development keeps the HTTPS redirect, HSTS and host allow-list
# switched off so localhost works. Set it to "production" the moment the API is
# reachable from anywhere but this machine -- nothing else needs to change.
ENVIRONMENT=development
# Comma-separated. These three are the local Vite and test-page origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500
# Host header allow-list, enforced only outside development. "*" disables it.
TRUSTED_HOSTS=*
# Per-IP request budgets. Leave on: /recommend spends a Voyage call and a Sonnet
# call per request, and the endpoint is unauthenticated.
RATE_LIMIT_ENABLED=true

# Unlocks ?view=review for pending Dropbox posters (routers/review.py). Empty = off.
# Long random value: python -c "import secrets; print(secrets.token_urlsafe(32))"
REVIEW_KEY=
